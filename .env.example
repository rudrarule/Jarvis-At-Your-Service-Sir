# ─────────────────────────────────────────────────────────────
# J.A.R.V.I.S Environment Configuration Template
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file with real secrets
# ─────────────────────────────────────────────────────────────

# ── LLM Configuration ──────────────────────────────────────────
# Use local Ollama by default, or enable Claude/Bedrock for complex queries
USE_CLAUDE=true
CLAUDE_MODEL_ID=meta.llama4-maverick-17b-instruct-v1:0
CLAUDE_MAX_TOKENS=1024
AWS_BEDROCK_REGION=us-west-1

# ── API Keys (Third-party LLM Providers) ────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_GENERATIVEAI_KEY=your_google_api_key_here

# ── WhatsApp Baileys Connector ─────────────────────────────────
# REST API port for the Baileys WhatsApp connector
PORT=3100

# Jarvis FastAPI backend URL (used by WhatsApp connector)
JARVIS_BACKEND_URL=http://localhost:8002

# Approved phone numbers for WhatsApp auto-reply (E.164 format without +)
# Example: 919876543210,918765432109
APPROVED_CONTACTS=919876543210,918765432109

# Cooldown period in hours before re-sending auto-reply to same contact
AUTO_REPLY_COOLDOWN_HOURS=12

# Auto-reply message text when busy
AUTO_REPLY_MESSAGE=Hi, I am Jarvis, your personal assistant. I'm a bit busy at the moment, but I'll get back to you shortly.

# Pino logger level (info, debug, warn, error)
LOG_LEVEL=info

# ── Twilio WhatsApp Integration (Optional) ─────────────────────
# If using Twilio for WhatsApp instead of Baileys
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+1234567890

# ── AWS S3 / Bedrock Configuration ──────────────────────────────
# Required if using boto3 for AWS services
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# ── FastAPI Backend Configuration ──────────────────────────────
# Backend API host and port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8002

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Browser Automation (Playwright) ────────────────────────────
# Show the browser window (false) or run headless (true)
BROWSER_HEADLESS=false
# Include a viewport screenshot in each observation (enables vision verification)
BROWSER_OBSERVE_SCREENSHOTS=true
#
# RECOMMENDED on Windows: attach to a real, already-running Chrome over the
# DevTools protocol instead of letting Playwright launch its own Chromium.
# This avoids the Windows SelectorEventLoop "NotImplementedError" (browser fails
# to launch) and reuses your logged-in browser so login flows work.
#
# 1) Start Chrome once with remote debugging (own profile dir keeps it separate):
#      chrome.exe --remote-debugging-port=9222 --user-data-dir="C:/jarvis-chrome"
# 2) Set the URL below. Leave BLANK to keep the old launch-our-own behavior.
BROWSER_CDP_URL=http://localhost:9222

# ── MCP (Model Context Protocol) tools ─────────────────────────
# Plug external MCP servers into the agent's tool list. OFF by default.
# Requires: pip install langchain-mcp-adapters  (and Node `npx` + `uvx` on PATH).
JARVIS_MCP=false
# Free web-search MCP (no credit card) — sign up at tavily.com for the key.
TAVILY_API_KEY=
# Opt-in filesystem MCP (adds ~10 tools; keep off unless needed). Scope the root.
JARVIS_MCP_FS=false
JARVIS_MCP_FS_ROOT=C:/Users/Rudra
# Route-scoped MCP binding: only bind MCP tools relevant to the router's route
# (web tools on browser/mission, fs tools on tool/mission). Keeps Nova's tool
# list small as you add servers. Native tools are always bound. Default ON.
JARVIS_ROUTE_SCOPED_TOOLS=true

# ── Optional: Additional Integrations ──────────────────────────
# Weather API (if using weather tool)
WEATHER_API_KEY=your_weather_api_key

# Music Service (if using music playback tool)
MUSIC_SERVICE_API_KEY=your_music_service_key

# ─────────────────────────────────────────────────────────────
# Local Development Notes:
# - Ollama should be running locally for local LLM inference
# - WhatsApp Baileys connector requires Node.js 18+
# - FastAPI backend requires Python 3.9+
# ─────────────────────────────────────────────────────────────
